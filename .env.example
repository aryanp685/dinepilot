NODE_ENV=development
PORT=4000
WEB_PORT=3000
PUBLIC_APP_URL=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000

MONGODB_URI=
USE_EMBEDDED_MONGO=true
AUTO_SEED_DEMO=true

JWT_SECRET=replace-with-at-least-32-char-cryptographic-secret-key
COOKIE_SECRET=replace-with-cookie-signing-secret-key
SESSION_TTL_HOURS=168

DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_LOCALE=en-IN

AI_PROVIDER=rule-based
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=10000

PAYMENT_WEBHOOK_SECRET=replace-with-gateway-webhook-hmac-secret
